---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DemoBanner from '../../components/DemoBanner.astro';
import { getVisible, url, asset, slugify, formatDate, isoDate } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getVisible('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
---
<Base title={d.title} description={d.description} type="article" published={d.date} image={d.cover?.src}>
  <article class="wrap">
    <header class="article-head">
      <DemoBanner status={d.status} demo={d.demo} />
      <span class="kicker">Blog</span>
      <h1>{d.title}</h1>
      <div class="article-meta">
        <time datetime={isoDate(d.date)}>{formatDate(d.date)}</time>
        {d.updated && <span>Updated <time datetime={isoDate(d.updated)}>{formatDate(d.updated)}</time></span>}
        {d.categories.map((c) => <a class="chip" href={url(`/blog/category/${slugify(c)}/`)}>{c}</a>)}
      </div>
    </header>
    {d.cover && <figure class="cover measure"><img src={asset(d.cover.src)} alt={d.cover.alt} /></figure>}
    <div class="prose"><Content /></div>
    <a class="back-link" href={url('/blog/')}>← All posts</a>
  </article>
</Base>
