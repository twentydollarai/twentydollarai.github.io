    "@fontsource/inter": "^5.3.0",
    "astro": "^7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "typescript": "^6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  }
