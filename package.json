  "description": "Twenty Dollar AI: real-world tests of affordable AI subscriptions.",
  "scripts": {
    "dev": "astro dev",
    "dev:demo": "SHOW_DEMO=true astro dev",
    "build": "astro build",
    "build:demo": "SHOW_DEMO=true astro build --outDir dist-demo",
    "preview": "astro preview",
